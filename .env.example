# Existing Supabase integration variable names. Use the existing project.
NEXT_PUBLIC_POSTGRES_SUPABASE_URL=
NEXT_PUBLIC_POSTGRES_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is supported if no publishable key is set.
NEXT_PUBLIC_POSTGRES_SUPABASE_ANON_KEY=
POSTGRES_URL=
# Optional CA PEM for verified Postgres TLS / admin bootstrap.
POSTGRES_CA_CERT=
SITE_URL=https://www.maison-delux.com
# Separate cryptographically random server secrets, at least 32 bytes each.
GUEST_TRIAL_HMAC_SECRET=
INFERENCE_GATEWAY_SECRET=
# Optional backend base URL; development defaults to http://127.0.0.1:5000.
ML_BACKEND_URL=
GUEST_TRIAL_WINDOW_DAYS=30
GUEST_NETWORK_DAILY_CAP=8
GUEST_ESTIMATION_RATE_LIMIT=6
USER_ESTIMATION_RATE_LIMIT=30
GUEST_SIMULATION_RATE_LIMIT=15
USER_SIMULATION_RATE_LIMIT=60
AUTH_RATE_LIMIT=20
# Outside Vercel, only set behind a proxy that overwrites the named IP header.
TRUSTED_CLIENT_IP_HEADER=
# Keep legacy compatibility until the first Supabase admin has been verified.
ADMIN_AUTH_MODE=compatibility
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
